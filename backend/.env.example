# Backend Environment Variables
DATABASE_URL=sqlite:///./interviewiq.db
# PostgreSQL / Supabase connection example:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase Auth
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=dev-secret-key-change-in-production-1234567890

# AI Provider Configuration
LLM_PROVIDER=mock   # Options: mock, openai, gemini, anthropic
LLM_API_KEY=        # Provide API key for real AI calls (e.g., sk-...)
LLM_MODEL=gpt-4o-mini
MOCK_AI_MODE=true

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
